# Database Configuration
DB_ROOT_PASSWORD=your_root_password
DB_NAME=multivendor_marketplace
DB_USERNAME=marketplace
DB_PASSWORD=your_database_password
DB_PORT=3306

# Redis Configuration
REDIS_PORT=6379

# Kafka Configuration
